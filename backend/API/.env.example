# MariaDB: usa el host o nombre del servicio accesible desde la API, no localhost en Dokploy.
MYSQL_HOST=host-de-mariadb
MYSQL_PORT=3306
MYSQL_USER=usuario
MYSQL_PASSWORD=tu-contrasena
MYSQL_DB=marqueza_db

# SMTP Gmail: usa una contraseña de aplicacion, no la contraseña de tu cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=tu-correo@gmail.com
SMTP_PASSWORD=tu-contrasena-de-aplicacion
SMTP_FROM=tu-correo@gmail.com
SMTP_TIMEOUT=15
FRONTEND_RESET_URL=http://localhost:5500/frontend/olvido_contrasena/restablecer.html
