  "components": {
    "parameters": {
      "Id": { "name": "id", "in": "path", "required": true, "description": "Identificador del recurso", "schema": { "type": "integer", "minimum": 1 } }
    },
    "responses": {
      "Ok": { "description": "Operación exitosa" },
      "BadRequest": { "description": "Solicitud inválida" },
      "NotFound": { "description": "Recurso no encontrado" }
    },
    "requestBodies": {
      "Cliente": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Cliente" } } } },
      "Contacto": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Contacto" } } } },
      "Cotizacion": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Cotizacion" } } } },
      "DetalleEtc": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DetalleEtc" } } } },
      "Etc": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Etc" } } } },
      "Insumo": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Insumo" } } } },
      "Persona": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Persona" } } } },
      "PersonaUpdate": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PersonaUpdate" } } } },
      "Producto": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Producto" } } } },
      "ProductoInsumo": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductoInsumo" } } } },
      "Proveedor": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Proveedor" } } } },
      "Usuario": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Usuario" } } } },
      "UsuarioUpdate": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UsuarioUpdate" } } } },
      "Venta": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Venta" } } } },
      "VentaProducto": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VentaProducto" } } } }
    },
    "schemas": {
      "Cliente": { "type": "object", "required": ["persona_id"], "properties": { "persona_id": { "type": "integer", "minimum": 1 } } },
      "Contacto": { "type": "object", "required": ["tipo_contacto", "contenido", "proveedor_id"], "properties": { "tipo_contacto": { "type": "string" }, "contenido": { "type": "string" }, "proveedor_id": { "type": "integer" } } },
      "Cotizacion": { "type": "object", "required": ["pro_codigo", "pro_nombre", "pro_cantidad", "pro_precio", "total_pagar", "usuario_id", "cliente_id"], "properties": { "pro_codigo": { "type": "string" }, "pro_nombre": { "type": "string" }, "pro_cantidad": { "type": "number" }, "pro_precio": { "type": "number" }, "total_pagar": { "type": "number" }, "usuario_id": { "type": "integer" }, "cliente_id": { "type": "integer" } } },
      "DetalleEtc": { "type": "object", "required": ["det_etc_nombre", "det_etc_etc_id", "det_etc_per_id"], "properties": { "det_etc_nombre": { "type": "string" }, "det_etc_etc_id": { "type": "integer" }, "det_etc_per_id": { "type": "integer" } } },
      "Etc": { "type": "object", "required": ["etc_nombre"], "properties": { "etc_nombre": { "type": "string" } } },
      "Insumo": { "type": "object", "required": ["codigo", "nombre", "cantidad", "precio", "estado", "usuario_id", "proveedor_id", "etc_id"], "properties": { "codigo": { "type": "string" }, "nombre": { "type": "string" }, "cantidad": { "type": "number" }, "precio": { "type": "number" }, "estado": { "type": "string" }, "usuario_id": { "type": "integer" }, "proveedor_id": { "type": "integer" }, "etc_id": { "type": "integer" } } },
      "Persona": { "type": "object", "required": ["nombre", "pri_apellido", "correo", "direccion", "identificacion", "telefono"], "properties": { "nombre": { "type": "string" }, "seg_nombre": { "type": "string" }, "pri_apellido": { "type": "string" }, "seg_apellido": { "type": "string" }, "correo": { "type": "string", "format": "email" }, "direccion": { "type": "string" }, "identificacion": { "type": "string" }, "telefono": { "type": "string" } } },
      "PersonaUpdate": { "type": "object", "minProperties": 1, "properties": { "nombre": { "type": "string" }, "seg_nombre": { "type": "string" }, "pri_apellido": { "type": "string" }, "seg_apellido": { "type": "string" }, "correo": { "type": "string", "format": "email" }, "direccion": { "type": "string" }, "identificacion": { "type": "string" }, "telefono": { "type": "string" } } },
      "Producto": { "type": "object", "required": ["codigo", "nombre", "cantidad", "precio", "estado", "usua_id", "det_etc_id"], "properties": { "codigo": { "type": "string" }, "nombre": { "type": "string" }, "cantidad": { "type": "number" }, "precio": { "type": "number" }, "estado": { "type": "string" }, "usua_id": { "type": "integer" }, "det_etc_id": { "type": "integer" } } },
      "ProductoInsumo": { "type": "object", "required": ["cantidad", "producto_id", "insumo_id"], "properties": { "cantidad": { "type": "number" }, "producto_id": { "type": "integer" }, "insumo_id": { "type": "integer" } } },
      "Proveedor": { "type": "object", "required": ["per_id"], "properties": { "per_id": { "type": "integer", "minimum": 1 } } },
      "Usuario": { "type": "object", "required": ["nombre", "correo", "contrasena"], "properties": { "nombre": { "type": "string" }, "correo": { "type": "string", "format": "email" }, "contrasena": { "type": "string", "format": "password" }, "estado": { "type": "string", "default": "ACTIVO" }, "det_etc_id": { "type": "integer", "nullable": true } } },
      "UsuarioUpdate": { "type": "object", "minProperties": 1, "properties": { "nombre": { "type": "string" }, "correo": { "type": "string", "format": "email" }, "contrasena": { "type": "string", "format": "password" }, "estado": { "type": "string" }, "det_etc_id": { "type": "integer", "nullable": true } } },
      "Venta": { "type": "object", "required": ["fecha", "usua_id", "cli_id"], "properties": { "fecha": { "type": "string", "format": "date" }, "usua_id": { "type": "integer" }, "cli_id": { "type": "integer" } } },
      "VentaProducto": { "type": "object", "required": ["cantidad", "vent_id", "prod_id"], "properties": { "cantidad": { "type": "number" }, "vent_id": { "type": "integer" }, "prod_id": { "type": "integer" } } }
    }
  }
}
