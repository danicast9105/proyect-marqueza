      "put": { "tags": ["Ventas"], "summary": "Actualizar venta", "requestBody": { "$ref": "#/components/requestBodies/Venta" }, "responses": { "200": { "$ref": "#/components/responses/Ok" }, "400": { "$ref": "#/components/responses/BadRequest" } } },
