      "put": { "tags": ["Proveedores"], "summary": "Actualizar proveedor", "requestBody": { "$ref": "#/components/requestBodies/Proveedor" }, "responses": { "200": { "$ref": "#/components/responses/Ok" }, "400": { "$ref": "#/components/responses/BadRequest" } } },
