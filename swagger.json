      "post": { "tags": ["Ventas"], "summary": "Crear venta", "requestBody": { "$ref": "#/components/requestBodies/Venta" }, "responses": { "201": { "$ref": "#/components/responses/Ok" }, "400": { "$ref": "#/components/responses/BadRequest" } } }
    },
