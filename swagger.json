      "post": { "tags": ["Ventas-productos"], "summary": "Crear relación venta-producto", "requestBody": { "$ref": "#/components/requestBodies/VentaProducto" }, "responses": { "201": { "$ref": "#/components/responses/Ok" }, "400": { "$ref": "#/components/responses/BadRequest" } } }
