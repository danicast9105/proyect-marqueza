# Define these variables in the Dokploy application's Environment section.
# Generate unique, long passwords before deploying. Do not commit real secrets.
MARIADB_ROOT_PASSWORD=replace-with-a-long-random-password
MARIADB_USER=marqueza_app
MARIADB_PASSWORD=replace-with-another-long-random-password

# Email is optional. Configure all SMTP values to enable password recovery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=tu-correo@gmail.com
SMTP_PASSWORD=tu-contrasena-de-aplicacion
SMTP_FROM=tu-correo@gmail.com
SMTP_TIMEOUT=15
FRONTEND_RESET_URL=https://app.tudominio.com/frontend/olvido_contrasena/restablecer.html
